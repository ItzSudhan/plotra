# Copy to .env.local and fill in. Everything marked optional can stay empty.

# Postgres connection string (Neon: Dashboard → Connect → "Pooled connection").
# Or `pglite:./.plotra-local` for a Postgres inside the app, in a folder (no server
# needed; created and migrated on first use), as local mode runs it.
DATABASE_URL=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional: Google sign-in. Callback: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: connect GitHub from Project settings → GitHub, to pick or make the
# repository a project is copied to (unset, people paste a token instead).
# A GitHub App (github.com/settings/apps), public, with "Request user authorization
# during installation" off, callback <BETTER_AUTH_URL>/api/auth/callback/github,
# and permissions Contents: read and write, Administration: read and write (to make
# repositories), Metadata: read, and Email addresses: read. Not a way to sign in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: the app's name in its github.com/apps/<slug> address, for the link
# that lets people choose which repositories Plotra can use.
GITHUB_APP_SLUG=

# Collab server (apps/collab). Same secret as COLLAB_SECRET in apps/collab/.dev.vars.
COLLAB_SECRET=
NEXT_PUBLIC_COLLAB_URL=http://localhost:8787
# Optional: the collab server's address as the app server reaches it, if different.
COLLAB_INTERNAL_URL=

# Optional: email over SMTP, e.g. smtps://user:password@smtp.example.com:465
# Unset, emails are logged to the console.
SMTP_URL=
# Optional: the sender. Unset, it is the SMTP login.
EMAIL_FROM=

# Optional: secret for the daily digest (/api/cron/digest). Unset, no digest is sent.
CRON_SECRET=

# Optional: file storage in any S3-compatible store. Unset, files are kept in Postgres.
# Cloudflare R2: S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# Optional: Postgres driver, `neon`, `pg` or `pglite`. Unset, picked from the URL.
DATABASE_DRIVER=

# Optional: also copy usage events to PostHog.
NEXT_PUBLIC_POSTHOG_KEY=

# Optional: the marketing site's address, for links back to it.
NEXT_PUBLIC_SITE_URL=

# Optional: error tracking. Rebuild after changing it.
SENTRY_DSN=

# Optional: where readers report a public read-only link that breaks the rules.
# Shows a "Report" link in the public reader when set.
REPORT_EMAIL=

# Optional: lets people save their own AI key. Generate with: openssl rand -base64 32
# Changing it makes every saved key unreadable.
AI_KEY_SECRET=
# Optional: the server's own model. With billing on, only Pro workspaces use it.
# AI_PROVIDER: anthropic, openai, openrouter, compatible or ollama.
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL_AGENT=
AI_MODEL_FAST=
# Optional: `true` lets the server call models on localhost. Never on a public server.
AI_ALLOW_PRIVATE_URLS=
# Optional: `1` takes AI out of this server altogether. No workspace can switch it on.
PLOTRA_NO_AI=
# Optional: `true` lets webhooks post to localhost and private networks. Never on a public server.
WEBHOOK_ALLOW_PRIVATE_URLS=

# Optional: paid plans through Creem. Unset, there are no plans and no limits.
CREEM_API_KEY=
# Signing secret of the webhook at <app>/api/billing/webhook.
CREEM_WEBHOOK_SECRET=
# The Creem product ids (prod_…) for Pro.
CREEM_PRODUCT_PRO_MONTHLY=
CREEM_PRODUCT_PRO_YEARLY=
