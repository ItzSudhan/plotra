{
  "expo": {
    "name": "Plotra",
    "slug": "plotra",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "plotra",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "ink.plotra.app",
      "supportsTablet": true,
      "config": { "usesNonExemptEncryption": false }
    },
    "android": {
      "package": "ink.plotra.app",
      "adaptiveIcon": {
        "backgroundColor": "#161412",
        "foregroundImage": "./assets/images/splash-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#f7f6f3",
          "dark": { "backgroundColor": "#141311", "image": "./assets/images/splash-icon.png" }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
