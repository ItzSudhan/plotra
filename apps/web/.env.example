# Copy to .env.local. See plan.md, section 6.

# The app, for the "Sign in" and "Start writing" links. Defaults to http://localhost:3000.
# In production this must be set, e.g. https://app.plotra.ink
NEXT_PUBLIC_APP_URL=

# The docs site, for the "Docs" links. Defaults to http://localhost:3002.
NEXT_PUBLIC_DOCS_URL=

# This site's own address, used for link previews, canonical links, robots.txt and the sitemap.
# Defaults to http://localhost:3001. In production this must be set, or search engines are sent to localhost.
NEXT_PUBLIC_SITE_URL=

# Optional: page views and clicks in PostHog, sent through this site's /ingest.
NEXT_PUBLIC_POSTHOG_KEY=
# Unset, PostHog's US cloud: https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=
