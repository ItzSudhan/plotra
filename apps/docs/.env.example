# Copy to .env.local.

# This site's own address, used for link previews. Defaults to http://localhost:3002.
NEXT_PUBLIC_DOCS_URL=

# Where "Start writing" and "Pricing" lead. Default to https://app.plotra.ink and https://plotra.ink.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=

# Where reader feedback is posted, as well as the server log. A Discord or Slack webhook address works as is.
FEEDBACK_WEBHOOK_URL=

# Optional: page views and clicks in PostHog, sent through this site's /ingest.
NEXT_PUBLIC_POSTHOG_KEY=
# Unset, PostHog's US cloud: https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=
