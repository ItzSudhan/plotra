# Settings for the self-hosted stack (docker/compose.yaml).
#
#   cp .env.example .env
#
# then generate the secrets. This fills in every empty secret below, and works
# on Linux and macOS:
#
#   for name in POSTGRES_PASSWORD BETTER_AUTH_SECRET COLLAB_SECRET S3_SECRET_ACCESS_KEY AI_KEY_SECRET; do
#     sed -i.bak "s|^$name=\$|$name=$(openssl rand -hex 32)|" .env
#   done && rm -f .env.bak
#
# Lines it has already filled are left alone, so it is safe to run again.
# Keep .env private: it holds every secret of the instance. Git ignores it.

# ---------------------------------------------------------------------------
# What runs
# ---------------------------------------------------------------------------

# The optional parts of the stack, comma-separated.
#   postgres  the bundled Postgres. Remove it when DATABASE_URL points elsewhere.
#   minio     the bundled S3 store for uploads and version snapshots. Remove it
#             to use another S3 store, Cloudflare R2, or no store at all.
#   collab    the bundled collab server. Remove it only if you deploy
#             apps/collab to your own Cloudflare account instead.
COMPOSE_PROFILES=postgres,minio,collab

# Which published images `docker compose pull` fetches: a release such as
# 0.1.0, or latest. Pin a release to upgrade only when you choose to.
PLOTRA_VERSION=latest

# ---------------------------------------------------------------------------
# Addresses
# ---------------------------------------------------------------------------

# The URL people open Plotra at, without a trailing slash. Sign-in cookies,
# links in emails and the collab server's token check all use it, so it has to
# be exactly what the browser's address bar shows.
# Behind a reverse proxy: https://plotra.example.com
BETTER_AUTH_URL=http://localhost:3000

# The URL browsers reach the collab server at (they open a WebSocket to it).
# Behind a reverse proxy: https://collab.plotra.example.com
# This one is compiled into the app when its image is built. After changing it:
#   docker compose up -d --build app
NEXT_PUBLIC_COLLAB_URL=http://localhost:8787

# The host ports the app and the collab server are published on, and the
# address they bind to. Set the BIND values to 127.0.0.1 when a reverse proxy
# on the same machine is the only thing that should reach them.
APP_PORT=3000
APP_BIND=0.0.0.0
COLLAB_PORT=8787
COLLAB_BIND=0.0.0.0

# ---------------------------------------------------------------------------
# Secrets (generated by the command at the top)
# ---------------------------------------------------------------------------

# Signs sessions and tokens. Changing it signs everyone out.
BETTER_AUTH_SECRET=

# Shared by the app and the collab server, so each knows the other is calling.
COLLAB_SECRET=

# Password of the bundled Postgres. It is set when the database volume is first
# created; changing it here later does not change it in the database.
POSTGRES_PASSWORD=

# Encrypts the AI provider keys people save in Settings → AI. Without it nobody
# can save a key. Changing it makes the saved keys unreadable.
AI_KEY_SECRET=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Leave empty to use the bundled Postgres. To use Neon or your own Postgres,
# put its connection string here and remove `postgres` from COMPOSE_PROFILES.
# The role must own the database and be allowed to create roles.
DATABASE_URL=

# Which driver the app connects with: `pg` (plain TCP) or `neon` (Neon's
# WebSocket driver). Empty picks `neon` for a *.neon.tech host and `pg` for
# everything else, which is right nearly always.
DATABASE_DRIVER=

# ---------------------------------------------------------------------------
# Files (uploads and version snapshots)
# ---------------------------------------------------------------------------

# An S3-compatible store. These defaults are the bundled MinIO, which takes
# S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY as its root user and password
# (the password must be at least 8 characters).
# For another store, change them and remove `minio` from COMPOSE_PROFILES.
# For no store, empty S3_ENDPOINT too: files then live in Postgres, with
# smaller limits (10 MB a file, 100 MB a project).
S3_ENDPOINT=http://minio:9000
S3_BUCKET=plotra
S3_ACCESS_KEY_ID=plotra
S3_SECRET_ACCESS_KEY=
# The region requests are signed for. Empty means us-east-1, MinIO's default.
S3_REGION=

# For Cloudflare R2, as the hosted version uses, S3_ENDPOINT is
# https://<account id>.r2.cloudflarestorage.com

# ---------------------------------------------------------------------------
# Email (optional)
# ---------------------------------------------------------------------------

# Without an SMTP server no email is sent. Invitation and sharing links are
# written to the app's log instead:  docker compose logs app
# Any mail service works: smtps://user:password@smtp.example.com:465
# (smtps:// for port 465, smtp:// for 587).
SMTP_URL=
# The sender: Plotra <plotra@example.com>. Unset, it is the SMTP login.
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Google sign-in (optional)
# ---------------------------------------------------------------------------

# Email and password sign-in always works. The Google button appears when both
# are set. Callback URL to register: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# AI (optional)
# ---------------------------------------------------------------------------

# By default each person adds their own provider key in Settings → AI (this
# needs AI_KEY_SECRET above). To give the whole instance one model instead,
# set these. With paid plans on (below), it is the model Pro workspaces run
# on, counted in monthly credits. Providers: anthropic, openai, openrouter, compatible, ollama.
AI_PROVIDER=
AI_API_KEY=
# For `compatible` and `ollama`. An Ollama on the Docker host is
# http://host.docker.internal:11434/v1
AI_BASE_URL=
AI_MODEL_AGENT=
AI_MODEL_FAST=
# Lets model URLs point at this machine or the local network, which a local
# model needs. Set to false if strangers can sign up on your instance.
AI_ALLOW_PRIVATE_URLS=true
# 1 takes AI out of this server altogether: no workspace can switch it on and
# nobody can save a key. Unset it to bring the switches back.
PLOTRA_NO_AI=
# true lets webhooks post to this machine or your network (n8n, Home Assistant)
# and over plain http. Leave it unset if strangers can sign up.
WEBHOOK_ALLOW_PRIVATE_URLS=

# ---------------------------------------------------------------------------
# Paid plans (optional, and off by default)
# ---------------------------------------------------------------------------

# Leave these empty and there are no plans at all: no Free or Pro, no checkout,
# and no limits on projects or storage. Set them only to charge the
# people on your instance through your own Creem account (creem.io). See the
# docs' Self-hosting page, "Plans and billing".
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_PRO_MONTHLY=
CREEM_PRODUCT_PRO_YEARLY=

# ---------------------------------------------------------------------------
# Other optional settings
# ---------------------------------------------------------------------------

# Error tracking. Read when the app image is built as well as when it runs.
SENTRY_DSN=

# Where readers report a public read-only link that breaks the rules. Shows a
# "Report" link in the public reader when set. See the self-hosting guide,
# "Reports and takedowns".
REPORT_EMAIL=

# Compiled into the app when its image is built, like NEXT_PUBLIC_COLLAB_URL.
# See apps/app/.env.example for what each one does.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# The image of the bundled S3 store, if you want another build or version.
# MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
